# Application
APP_ENV=development
LOG_LEVEL=info

# Docker Compose
API_PORT=8080
# Match these values to `id -u` and `id -g` when they are not 1000.
APP_UID=1000
APP_GID=1000

# Local `go run` addresses. Compose fixes the container ports to 8080/8081.
PUBLIC_ADDR=:8080
INTERNAL_ADDR=:8081
SHUTDOWN_TIMEOUT=10s

# Local `go run` path. Compose uses /app/data/log-platform.db.
DATABASE_PATH=./data/log-platform.db

# API limits
MAX_LOG_MESSAGE_BYTES=65536
MAX_INGEST_BODY_BYTES=16777216
MAX_INGEST_BATCH_SIZE=1000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Log producer
# Local `go run` path. Compose uses /logs/events.ndjson.
PRODUCER_LOG_PATH=./data/producer/events.ndjson
PRODUCER_INTERVAL=1s
PRODUCER_CYCLES=0
# Optional. Leave unset to generate a unique run ID.
# For Compose, export it in the current shell before `docker compose up`.
# PRODUCER_RUN_ID=acceptance-run
