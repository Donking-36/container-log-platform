# Application
APP_ENV=development
LOG_LEVEL=info

# HTTP servers
PUBLIC_ADDR=:8080
INTERNAL_ADDR=:8081
SHUTDOWN_TIMEOUT=10s

# SQLite
DATABASE_PATH=./data/log-platform.db

# API limits
MAX_LOG_MESSAGE_BYTES=65536
MAX_INGEST_BODY_BYTES=16777216
MAX_INGEST_BATCH_SIZE=1000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
